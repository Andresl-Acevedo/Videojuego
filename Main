package videojuegos;
public class Videojuegos {

    public static void main(String[] args) {
        Jugador jugador = new Jugador("Andres Piastri / Caballero");

        jugador.crearPersonaje("Guerrero", 1, 100, 100);

        Personaje personaje = jugador.getPersonaje();

        System.out.println("Jugador: " + jugador.getNombre());
        System.out.println("Personaje: " + personaje.getNombre());
        System.out.println("Nivel: " + personaje.getNivel());
        System.out.println("Vida: " + personaje.getPuntosVida());

        personaje.subirNivel();

        System.out.println("Nuevo nivel: " + personaje.getNivel());

        personaje.recibirDaño(30);

        System.out.println("Vida despues del daño: " + personaje.getPuntosVida());

        personaje.recuperarVida(20);

        System.out.println("Vida despues de recuperar: " + personaje.getPuntosVida());

        personaje.getInventario().agregarObjeto("Espada");
        personaje.getInventario().agregarObjeto("Pocion");

        System.out.println("Objetos:");
        personaje.getInventario().mostrarObjetos();
        
        jugador.eliminarPersonaje();
    }
    }
