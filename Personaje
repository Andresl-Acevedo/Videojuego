package videojuegos;

public class Personaje {

    private String nombre;
    private int nivel;
    private int puntosVida;
    private int maxVida;
    private Inventario inventario;

    public Personaje(String nombre, int nivel, int puntosVida, int maxVida) {
        this.nombre = nombre;
        this.nivel = nivel;
        this.maxVida = maxVida;

        if (puntosVida >= 0 && puntosVida <= maxVida) {
            this.puntosVida = puntosVida;
        } else {
            this.puntosVida = maxVida;
        }

        this.inventario = new Inventario();
    }

    public String getNombre() {
        return nombre;
    }

    public int getNivel() {
        return nivel;
    }

    public int getPuntosVida() {
        return puntosVida;
    }

    public int getMaxVida() {
        return maxVida;
    }

    public Inventario getInventario() {
        return inventario;
    }

    public void subirNivel() {
        nivel++;
    }

    public void recibirDaño(int cantidad) {
        puntosVida -= cantidad;

        if (puntosVida < 0) {
            puntosVida = 0;
        }
    }

    public void recuperarVida(int cantidad) {
        puntosVida += cantidad;

        if (puntosVida > maxVida) {
            puntosVida = maxVida;
        }
    }
}
