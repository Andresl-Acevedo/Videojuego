package videojuegos;

public class Jugador {
    private String nombre;
    private Personaje personaje;

    public Jugador(String nombre) {
        this.nombre = nombre;
    }

    public String getNombre() {
        return nombre;
    }

    public Personaje getPersonaje() {
        return personaje;
    }

    public void crearPersonaje(String nombre, int nivel, int puntosVida, int maxVida) {
        personaje = new Personaje(nombre, nivel, puntosVida, maxVida);
    }
    
    public void eliminarPersonaje() {
        personaje = null;
    }
}
